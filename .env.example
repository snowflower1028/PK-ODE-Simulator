# 로컬 개발용 환경변수 예시. 이 파일을 .env 로 복사해서 쓰세요.
# .env 는 .gitignore 에 있으므로 저장소에 올라가지 않습니다.

DJANGO_DEBUG=True

# 아래 명령으로 새 키를 생성해서 넣으세요:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 추가 배포 호스트가 있으면 콤마로 구분해 입력 (예: pk.example.ac.kr)
DJANGO_ALLOWED_HOSTS=
